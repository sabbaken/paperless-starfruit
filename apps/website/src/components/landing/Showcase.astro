---
// "The app" — faithful CSS recreations of the real admin UI (no screenshots), in
// the app's own visual language: neutral cards, mono labels, gold active states.
const features = [
  {
    k: 'prompts',
    t: 'Prompts you actually control',
    d: 'Edit the whole extraction and OCR prompts, drop in variables like {{content}} or {{all_tags}}, and test against a real document before saving.',
  },
  {
    k: 'providers',
    t: 'Keys, masked and tested',
    d: 'Add a provider, hit Test to check it reaches, and pick which model handles OCR versus extraction. Keys are stored encrypted.',
  },
  {
    k: 'history',
    t: 'See exactly what was sent',
    d: 'Every run records the fully-rendered prompt and the raw model response, searchable — so a wrong result is easy to trace.',
  },
  {
    k: 'pipeline',
    t: 'Tune it to your archive',
    d: 'Page caps for cost, auto-apply on or off, polling interval, output language and a correspondent blacklist — all from the UI.',
  },
];
---

<section class="app section" id="app">
  <div class="container">
    <p class="eyebrow">The app</p>
    <h2 class="section-title">Everything runs from one polished web UI.</h2>
    <p class="lead">
      No config files to hand-edit. Connect paperless, add a key, pick your models, and
      watch documents move through the queue. Here is the part you&rsquo;ll use most.
    </p>

    <!-- ====================== REVIEW QUEUE (centerpiece) ====================== -->
    <div class="window reveal" aria-hidden="true">
      <div class="window__bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="window__addr">localhost:3000 / review</span>
      </div>
      <div class="window__body">
        <aside class="side">
          <div class="side__brand">
            <img src="/paperless-starfruit.png" width="20" height="20" alt="" />
            <span>Starfruit</span>
          </div>
          <nav class="side__nav">
            <span class="side__item">Dashboard</span>
            <span class="side__item is-active">Review <b class="side__badge">2</b></span>
            <span class="side__item">History</span>
            <span class="side__item">Settings</span>
          </nav>
          <div class="side__foot"><i class="status-dot"></i> paperless.home.lan</div>
        </aside>

        <div class="pane">
          <div class="pane__head">
            <div>
              <h4>Review queue</h4>
              <p>Approve, edit or reject AI suggestions</p>
            </div>
            <span class="pane__count">2 awaiting review</span>
          </div>

          <div class="review">
            <div class="rev-card">
              <div class="rev-card__t">Document&nbsp;#1042</div>
              <pre class="doc">VATTENFALL AB
Invoice no. 55-2026-0314
Billing period: 01–31 Mar 2026
Meter 7C·091 — 412 kWh
Amount due: 642.10 kr
Due date: 2026-04-02</pre>
            </div>

            <div class="rev-card">
              <div class="rev-card__t"><span class="spark">✦</span> AI suggestions</div>

              <div class="field">
                <label>Title</label>
                <div class="input">Electricity invoice — March 2026</div>
                <s class="was">Scan_20260314.pdf</s>
              </div>

              <div class="field">
                <label>Tags</label>
                <div class="tag-toggles">
                  <span class="tg tg--on">✓ utilities</span>
                  <span class="tg tg--on">✓ invoice <b>new</b></span>
                  <span class="tg tg--on">✓ 2026</span>
                  <span class="tg tg--off">✗ scan</span>
                </div>
              </div>

              <div class="two">
                <div class="field">
                  <label>Correspondent</label>
                  <div class="input">Vattenfall</div>
                </div>
                <div class="field">
                  <label>Date</label>
                  <div class="input">2026-03-14</div>
                </div>
              </div>

              <div class="actions">
                <span class="mini-btn mini-btn--ghost">Reject</span>
                <span class="mini-btn mini-btn--solid">Approve &amp; apply</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ====================== DASHBOARD + FEATURES ====================== -->
    <div class="grid2">
      <div class="window window--flat reveal" aria-hidden="true">
        <div class="window__bar window__bar--mini">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="window__addr">localhost:3000 / dashboard</span>
        </div>
        <div class="dash">
          <div class="stats">
            <div class="stat"><span>In queue</span><b>3</b><i>1 running</i></div>
            <div class="stat"><span>Awaiting review</span><b>2</b><i>&nbsp;</i></div>
            <div class="stat"><span>Processed</span><b>128</b><i class="bad">1 failed</i></div>
            <div class="stat"><span>Error rate</span><b>1%</b><i>127 of 128</i></div>
          </div>
          <div class="recent">
            <div class="recent__t">Recent activity</div>
            <div class="job"><span class="badge badge--done">done</span><span class="job__id">doc&nbsp;#1041</span><span class="job__tok">1,204 tok</span></div>
            <div class="job"><span class="badge badge--run">running</span><span class="job__id">doc&nbsp;#1042</span><span class="job__tok">&nbsp;</span></div>
            <div class="job"><span class="badge badge--fail">failed</span><span class="job__id">doc&nbsp;#1039</span><span class="job__retry">Retry</span></div>
            <div class="job"><span class="badge badge--queue">queued</span><span class="job__id">doc&nbsp;#1043</span><span class="job__tok">&nbsp;</span></div>
          </div>
        </div>
      </div>

      <ul class="features">
        {
          features.map((f) => (
            <li class="feature">
              <span class="feature__k">{f.k}</span>
              <h3 class="feature__t">{f.t}</h3>
              <p class="feature__d">{f.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- window chrome ---------- */
  .window {
    margin-top: clamp(40px, 5vw, 56px);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  .window__bar--mini {
    padding: 9px 14px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper-3);
  }
  .window__addr {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    margin-left: 12px;
  }
  .window__body {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--paper);
  }

  /* ---------- sidebar ---------- */
  .side {
    display: none;
    flex-direction: column;
    gap: 18px;
    padding: 18px 16px;
    border-right: 1px solid var(--line);
    background: var(--paper-2);
  }
  .side__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .side__brand img {
    border-radius: 6px;
  }
  .side__nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .side__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--ink-soft);
    padding: 8px 10px;
    border-radius: 8px;
  }
  .side__item.is-active {
    background: color-mix(in srgb, var(--gold) 22%, transparent);
    color: var(--ink);
    font-weight: 600;
  }
  .side__badge {
    margin-left: auto;
    background: var(--gold);
    color: #2a2300;
    font-size: 10px;
    font-weight: 700;
    border-radius: 999px;
    padding: 1px 7px;
  }
  .side__foot {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }

  /* ---------- pane ---------- */
  .pane {
    padding: clamp(16px, 3vw, 26px);
    min-width: 0;
  }
  .pane__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-soft);
  }
  .pane__head h4 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .pane__head p {
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin-top: 3px;
  }
  .pane__count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .review {
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }
  .rev-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 14px;
  }
  .rev-card__t {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }
  .spark {
    color: var(--gold-deep);
  }
  .doc {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    background: var(--paper-2);
    border-radius: 8px;
    padding: 12px;
    white-space: pre-wrap;
    overflow: hidden;
  }

  .field {
    margin-bottom: 13px;
  }
  .field label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    display: block;
    margin-bottom: 5px;
  }
  .input {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .was {
    display: inline-block;
    margin-top: 5px;
    font-size: 11px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .tag-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tg {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .tg--on {
    background: color-mix(in srgb, var(--gold) 20%, transparent);
    border-color: var(--gold-soft);
    color: #4a3a00;
  }
  .tg--on b {
    font-size: 8.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--gold);
    color: #2a2300;
    border-radius: 4px;
    padding: 0 4px;
    margin-left: 4px;
  }
  .tg--off {
    color: var(--ink-faint);
    text-decoration: line-through;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
  }
  .mini-btn {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 8px;
  }
  .mini-btn--ghost {
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }
  .mini-btn--solid {
    background: var(--ink);
    color: var(--paper);
  }

  /* ---------- dashboard + features ---------- */
  .grid2 {
    margin-top: clamp(28px, 4vw, 44px);
    display: grid;
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
  }
  .window--flat {
    margin-top: 0;
    box-shadow: var(--shadow);
  }
  .dash {
    padding: 16px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .stat {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 13px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .stat span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
  }
  .stat b {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat i {
    font-size: 10.5px;
    color: var(--ink-faint);
    font-style: normal;
  }
  .stat i.bad {
    color: var(--fail);
  }
  .recent {
    margin-top: 12px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 6px 13px;
  }
  .recent__t {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 9px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .job {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8rem;
  }
  .job:last-child {
    border-bottom: 0;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    text-transform: capitalize;
  }
  .badge--done {
    background: color-mix(in srgb, var(--ok) 18%, transparent);
    color: #2f6a45;
  }
  .badge--run {
    background: color-mix(in srgb, var(--run) 16%, transparent);
    color: #2f548f;
  }
  .badge--fail {
    background: color-mix(in srgb, var(--fail) 16%, transparent);
    color: #97402c;
  }
  .badge--queue {
    background: var(--paper-3);
    color: var(--ink-soft);
  }
  .job__id {
    font-family: var(--font-mono);
    color: var(--ink-faint);
    font-size: 11px;
  }
  .job__tok {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
  }
  .job__retry {
    margin-left: auto;
    font-size: 10.5px;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px 9px;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .feature {
    border-top: 2px solid var(--ink);
    padding-top: 14px;
  }
  .feature__k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--rind);
  }
  .feature__t {
    font-size: 1.08rem;
    margin-top: 8px;
  }
  .feature__d {
    margin-top: 7px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (min-width: 720px) {
    .window__body {
      grid-template-columns: 188px 1fr;
    }
    .side {
      display: flex;
    }
    .review {
      grid-template-columns: 1fr 1.05fr;
    }
    .features {
      grid-template-columns: 1fr 1fr;
      gap: 22px 28px;
    }
  }

  @media (min-width: 1000px) {
    .grid2 {
      grid-template-columns: 1.1fr 1fr;
    }
    .features {
      grid-template-columns: 1fr;
      align-self: stretch;
    }
  }
</style>

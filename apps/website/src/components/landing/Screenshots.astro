---
// Screenshots: one big horizontally-scrollable carousel. Slides are plain
// bordered images (no window chrome); scroll-snap does the work, the arrow
// buttons are a JS-only nicety on top. Drop images into `public/screenshots/`.
import { createT } from '@paperless-starfruit/shared';
const t = createT('en');
const shots = [
  {
    label: 'Dashboard',
    caption: t('site.screenshots.dashboardCaption'),
    src: '/screenshots/dashboard.png',
  },
  {
    label: 'Review queue',
    caption: t('site.screenshots.reviewCaption'),
    src: '/screenshots/review.png',
  },
  {
    label: 'Tags',
    caption: t('site.screenshots.tagsCaption'),
    src: '/screenshots/tags.png',
  },
  {
    label: 'Prompts',
    caption: t('site.screenshots.promptsCaption'),
    src: '/screenshots/prompts.png',
  },
  {
    label: 'API keys',
    caption: t('site.screenshots.apiKeysCaption'),
    src: '/screenshots/api-keys.png',
  },
];
---

<section class="shots section" id="screenshots">
  <div class="container shots__head">
    <div>
      <p class="eyebrow">{t('site.screenshots.eyebrow')}</p>
      <h2 class="section-title">{t('site.screenshots.title')}</h2>
    </div>
    <div class="shots__nav" aria-hidden="true">
      <button
        class="shots__btn"
        type="button"
        data-dir="-1"
        aria-label={t('site.screenshots.prevLabel')}
        tabindex="-1"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>
      <button
        class="shots__btn"
        type="button"
        data-dir="1"
        aria-label={t('site.screenshots.nextLabel')}
        tabindex="-1"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>
    </div>
  </div>

  <div
    class="shots__track"
    role="region"
    aria-label={t('site.screenshots.trackLabel')}
    tabindex="0"
  >
    {
      shots.map((s) => (
        <figure class="slide">
          <img
            src={s.src}
            alt={t('site.screenshots.imageAlt', { label: s.label })}
            loading="lazy"
            draggable="false"
          />
          <figcaption class="slide__cap">
            <strong>{s.label}</strong>: {s.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  // Arrow buttons: scroll the track one slide at a time. Scroll/drag/keyboard
  // work without this; the buttons are only an extra affordance.
  document.querySelectorAll<HTMLElement>('.shots').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.shots__track');
    if (!track) return;
    const slideStep = () => {
      const slide = track.querySelector<HTMLElement>('.slide');
      return slide ? slide.offsetWidth + 24 : track.clientWidth * 0.9;
    };
    root.querySelectorAll<HTMLButtonElement>('.shots__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        track.scrollBy({ left: slideStep() * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .shots {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper-2);
    overflow: hidden;
  }

  .shots__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .shots__nav {
    display: flex;
    gap: 8px;
    flex: none;
  }
  /* The buttons only do something with JS; without it the track still scrolls. */
  html:not(.js) .shots__nav {
    display: none;
  }
  .shots__btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition:
      color 0.15s,
      transform 0.15s;
  }
  .shots__btn:hover {
    color: var(--ink);
    transform: translateY(-1px);
  }

  /* Full-bleed scroll area whose first slide still lines up with the container. */
  .shots__track {
    margin-top: clamp(32px, 5vw, 48px);
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: max(24px, calc((100vw - var(--container)) / 2 + 24px));
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .shots__track::-webkit-scrollbar {
    display: none;
  }
  .shots__track:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .slide {
    margin: 0;
    flex: none;
    /* Large but viewport-friendly: the whole slide (plus caption) stays visible
       without precise page-scrolling, and the next slide still peeks in. */
    width: min(720px, 80vw);
    scroll-snap-align: center;
  }

  .slide img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    user-select: none;
  }

  .slide__cap {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .slide__cap strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>

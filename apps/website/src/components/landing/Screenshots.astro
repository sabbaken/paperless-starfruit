---
// Screenshots gallery.
//
// To drop in a real screenshot: put the image in `public/screenshots/` and set
// its `src` below (e.g. src: '/screenshots/dashboard.png'). While `src` is null
// a labelled placeholder is shown instead.
const shots = [
  { label: 'Dashboard', caption: 'Queue depth, throughput and recent runs.', src: '/screenshots/dashboard.png' },
  { label: 'Review queue', caption: 'Suggestions side-by-side with the document.', src: '/screenshots/review.png' },
  { label: 'Prompts', caption: 'Edit and test the prompts each model receives.', src: '/screenshots/prompts.png' },
  { label: 'API keys', caption: 'Add, test and mask your provider keys.', src: '/screenshots/api-keys.png' },
];
---

<section class="shots section" id="screenshots">
  <div class="container">
    <p class="eyebrow">Screenshots</p>
    <h2 class="section-title">A look at the app.</h2>
    <p class="lead">Everything is configured from one web UI — no config files to hand-edit.</p>

    <div class="shots__grid">
      {
        shots.map((s) => (
          <figure class="shot">
            <div class="shot__bar" aria-hidden="true">
              <span class="dot" /><span class="dot" /><span class="dot" />
              <span class="shot__addr">localhost:7827</span>
            </div>
            <div class="shot__body">
              {
                s.src ? (
                  <img src={s.src} alt={`${s.label} — Paperless Starfruit`} loading="lazy" />
                ) : (
                  <div class="ph">
                    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="18" height="18" x="3" y="3" rx="2" />
                      <circle cx="9" cy="9" r="2" />
                      <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
                    </svg>
                    <span class="ph__label">{s.label}</span>
                    <span class="ph__hint">Screenshot coming soon</span>
                  </div>
                )
              }
            </div>
            <figcaption class="shot__cap">{s.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .shots {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper-2);
  }

  .shots__grid {
    margin-top: clamp(40px, 6vw, 60px);
    display: grid;
    gap: clamp(22px, 3vw, 32px);
  }

  .shot {
    margin: 0;
  }

  .shot__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    background: var(--paper-3);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--white);
  }
  .shot__addr {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    margin-left: 10px;
  }

  .shot__body {
    aspect-ratio: 16 / 10;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0 0 var(--radius) var(--radius);
    overflow: hidden;
  }
  .shot__body img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .ph {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--ink-faint);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 11px,
        color-mix(in srgb, var(--paper-3) 55%, transparent) 11px 12px
      ),
      var(--paper);
  }
  .ph__label {
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .ph__hint {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
  }

  .shot__cap {
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  @media (min-width: 760px) {
    .shots__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

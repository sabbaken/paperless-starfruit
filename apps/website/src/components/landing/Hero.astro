---
// Hero. The signature element is the transformation figure on the right: a fresh
// scan carrying the `psf-process` tag resolving into the four metadata fields the
// product extracts (title, tags, correspondent, date). It is the product, in one image.
import { createT } from '@paperless-starfruit/shared';
const t = createT('en');
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{t('site.hero.eyebrow')}</p>
      <h1 class="hero__title">
        {t('site.hero.titleLine1')}<br />{t('site.hero.titleAfterBr')}<span class="hl"
          >{t('site.hero.titleHighlight')}</span
        >{t('site.hero.titleAfterHighlight')}
      </h1>
      <p class="lead">
        {t('site.hero.leadBefore')}<em>{t('site.hero.leadEm')}</em>{t('site.hero.leadAfter')}
      </p>

      <div class="hero__cta">
        <a class="btn btn--gold" href="/docs/installation/">
          {t('site.hero.ctaPrimary')}
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"
            ></path></svg
          >
        </a>
        <a class="btn btn--ghost" href="/docs/">{t('site.hero.ctaSecondary')}</a>
      </div>

      <ul class="hero__trust" aria-label={t('site.hero.trustLabel')}>
        <li>{t('site.hero.trustKeys')}</li>
        <li>{t('site.hero.trustSelfHosted')}</li>
        <li>{t('site.hero.trustContainer')}</li>
        <li>{t('site.hero.trustTelemetry')}</li>
      </ul>
    </div>

    <figure class="tf" aria-label={t('site.hero.figureLabel')}>
      <div class="tf__panel tf__scan">
        <span class="tf__cap">scanned · doc&nbsp;#1042</span>
        <div class="tf__sheet">
          <span class="tf__tag">psf-process</span>
          <span class="tf__bars">
            <i style="width:64%"></i>
            <i style="width:92%"></i>
            <i style="width:80%"></i>
            <i style="width:88%"></i>
            <i style="width:54%"></i>
            <i style="width:84%"></i>
            <i style="width:72%"></i>
          </span>
        </div>
      </div>

      <div class="tf__beam" aria-hidden="true">
        <span class="tf__star">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="#2a2300"
              d="M12 1.6l2.7 6.3 6.8.6-5.2 4.5 1.6 6.7L12 16.7 6.1 20.2l1.6-6.7L2.5 9l6.8-.6z"
            ></path>
          </svg>
        </span>
      </div>

      <div class="tf__panel tf__meta">
        <span class="tf__cap">filed · understood</span>
        <dl class="tf__fields">
          <div class="tf__field" style="--i:1">
            <dt>Title</dt>
            <dd>Electricity invoice, March 2026</dd>
          </div>
          <div class="tf__field" style="--i:2">
            <dt>Tags</dt>
            <dd class="tf__tags">
              <span class="chip chip--gold">utilities</span>
              <span class="chip chip--gold">invoice</span>
              <span class="chip chip--gold">2026</span>
            </dd>
          </div>
          <div class="tf__field" style="--i:3">
            <dt>Correspondent</dt>
            <dd>Vattenfall</dd>
          </div>
          <div class="tf__field" style="--i:4">
            <dt>Date</dt>
            <dd>2026-03-14</dd>
          </div>
        </dl>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(40px, 7vw, 84px);
    padding-bottom: clamp(48px, 8vw, 96px);
    position: relative;
    overflow: hidden;
  }

  /* faint starfruit-gold wash behind the hero */
  .hero::before {
    content: '';
    position: absolute;
    inset: -30% 40% auto -10%;
    height: 70%;
    background: radial-gradient(60% 60% at 30% 20%, rgba(235, 198, 37, 0.18), transparent 70%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    margin-top: 22px;
  }

  .hl {
    position: relative;
    white-space: nowrap;
  }
  .hl::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: 0.08em;
    height: 0.34em;
    background: var(--gold);
    z-index: -1;
    border-radius: 2px;
    transform: skewX(-12deg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 36px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hero__trust li::before {
    content: '✓';
    color: var(--rind);
    font-weight: 700;
  }

  /* ---------- the signature transformation figure ---------- */
  .tf {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px;
  }

  .tf__panel {
    position: relative;
    min-width: 0;
  }

  .tf__cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: block;
    margin-bottom: 10px;
  }

  .tf__sheet {
    position: relative;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 22px 18px 18px;
    box-shadow: var(--shadow);
    transform: rotate(-1.4deg);
    background-image: repeating-linear-gradient(var(--paper-2) 0 1px, transparent 1px 26px);
    background-position: 0 12px;
  }

  .tf__tag {
    position: absolute;
    top: -11px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: #2a2300;
    background: var(--gold);
    padding: 3px 9px;
    border-radius: 999px;
    box-shadow: 0 4px 10px -4px rgba(235, 198, 37, 0.9);
  }

  .tf__bars {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .tf__bars i {
    height: 8px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--paper-3), var(--paper-2));
    display: block;
  }

  .tf__beam {
    display: grid;
    place-items: center;
    padding-inline: 4px;
  }
  .tf__star {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gold);
    display: grid;
    place-items: center;
    box-shadow: 0 8px 22px -8px rgba(235, 198, 37, 1);
  }

  .tf__meta .tf__fields {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .tf__field {
    padding: 12px 15px;
    border-top: 1px solid var(--line-soft);
  }
  .tf__field:first-child {
    border-top: 0;
  }
  .tf__field dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .tf__field dd {
    margin: 3px 0 0;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .tf__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* extraction animation: fields populate in sequence on load */
  @media (prefers-reduced-motion: no-preference) {
    .tf__field {
      animation: tf-fill 0.45s both;
      animation-delay: calc(0.2s + var(--i) * 0.12s);
    }
    .tf__star {
      animation: tf-pulse 2.8s ease-in-out 1.4s infinite;
    }
    @keyframes tf-fill {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes tf-pulse {
      0%,
      100% {
        box-shadow: 0 8px 22px -8px rgba(235, 198, 37, 1);
      }
      50% {
        box-shadow: 0 8px 30px -4px rgba(235, 198, 37, 1);
      }
    }
  }

  @media (min-width: 940px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  /* stack the transform figure vertically on narrow screens */
  @media (max-width: 620px) {
    .tf {
      grid-template-columns: 1fr;
      gap: 4px;
      max-width: 360px;
      margin-inline: auto;
    }
    .tf__beam {
      transform: rotate(90deg);
      padding-block: 6px;
    }
    .tf__sheet {
      transform: rotate(-1deg);
    }
  }
</style>

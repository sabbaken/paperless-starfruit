---
import { createT } from '@paperless-starfruit/shared';
const t = createT('en');

const providers = [
  { name: 'Anthropic', icon: '/icons/providers/anthropic.png' },
  { name: 'OpenAI', icon: '/icons/providers/openai.png' },
  { name: 'Google', icon: '/icons/providers/google.png' },
  { name: 'Mistral', icon: '/icons/providers/mistral.png' },
];
---

<section class="keys section" id="keys" aria-labelledby="keys-title">
  <div class="container keys__layout">
    <div>
      <h2 class="section-title" id="keys-title">{t('site.byok.title')}</h2>
      <p class="lead">{t('site.byok.lead')}</p>
    </div>
    <ul class="providers" aria-label="Supported AI providers">
      {
        providers.map((provider) => (
          <li class="provider">
            <img src={provider.icon} width="24" height="24" alt="" loading="lazy" />
            <span>{provider.name}</span>
          </li>
        ))
      }
      <li class="provider provider--local">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="7" rx="2"></rect>
          <rect x="3" y="14" width="18" height="7" rx="2"></rect>
          <path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6"></path>
        </svg>
        <span class="provider__text">
          <span>{t('site.byok.localName')}</span>
          <span class="provider__hint">Local &amp; self-hosted</span>
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .keys {
    scroll-margin-top: 80px;
  }

  .keys .lead {
    max-width: 46ch;
  }

  .keys__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 64px;
  }

  .providers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
    width: 360px;
    max-width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .provider--local {
    grid-column: 1 / -1;
  }

  .provider {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 500;
  }

  .provider img {
    flex: none;
    border-radius: 6px;
  }

  .provider svg {
    flex: none;
  }

  .provider__text {
    display: grid;
    gap: 2px;
  }

  .provider__hint {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-soft);
  }

  @media (max-width: 1099px) {
    .keys__layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 540px) {
    .providers {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }
</style>

---
// Bring your own keys: the supported providers, kept brief.
const cloud = [
  {
    name: 'Anthropic',
    icon: '/icons/providers/anthropic.png',
    models: 'Claude Opus 4.5 · Sonnet 4.6 · Haiku 4.5',
  },
  { name: 'OpenAI', icon: '/icons/providers/openai.png', models: 'GPT-4.1 · GPT-4o · o4-mini' },
  { name: 'Google', icon: '/icons/providers/google.png', models: 'Gemini 2.5 Pro · 2.5 Flash' },
  {
    name: 'Mistral',
    icon: '/icons/providers/mistral.png',
    models: 'Mistral Large · Pixtral · Mistral OCR',
  },
];
---

<section class="keys section" id="keys">
  <div class="container">
    <p class="eyebrow">Bring your own keys</p>
    <h2 class="section-title">Use your own API keys.</h2>
    <p class="lead">
      Connect the providers you already pay for, or a model running on your own hardware.
    </p>

    <div class="providers">
      {
        cloud.map((p) => (
          <div class="provider">
            <img src={p.icon} width="28" height="28" alt={`${p.name} logo`} loading="lazy" />
            <div class="provider__text">
              <span class="provider__name">{p.name}</span>
              <span class="provider__models">{p.models}</span>
            </div>
          </div>
        ))
      }
      <div class="provider provider--local">
        <span class="provider__glyph" aria-hidden="true">&gt;_</span>
        <div class="provider__text">
          <span class="provider__name">Anything OpenAI-compatible</span>
          <span class="provider__models"
            >Ollama · LM Studio · vLLM · OpenRouter (local or remote)</span
          >
        </div>
      </div>
    </div>

    <p class="keys__note">
      Encrypted at rest, and sent straight to the provider, never through us.
    </p>
  </div>
</section>

<style>
  .providers {
    margin-top: clamp(36px, 5vw, 52px);
    display: grid;
    gap: 12px;
  }

  .provider {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
  }

  .provider img {
    border-radius: 7px;
    flex: none;
  }

  .provider__glyph {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--gold);
    border-radius: 7px;
    flex: none;
  }

  .provider__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .provider__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .provider__models {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    letter-spacing: 0.01em;
  }
  .provider--local {
    border-style: dashed;
    background: var(--paper);
  }

  .keys__note {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  @media (min-width: 720px) {
    .providers {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .provider--local {
      grid-column: 1 / -1;
    }
  }
</style>

---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/landing/Nav.astro';
import { createT } from '@paperless-starfruit/shared';
const t = createT('en');
---

<Landing title={t('site.notFound.metaTitle')} description={t('site.notFound.metaDescription')}>
  <Nav />
  <main class="nf">
    <p class="eyebrow">{t('site.notFound.eyebrow')}</p>
    <h1 class="nf__title">{t('site.notFound.title')}</h1>
    <p class="nf__lead">{t('site.notFound.lead')}</p>
    <div class="nf__btns">
      <a class="btn btn--gold" href="/">{t('site.notFound.backHome')}</a>
      <a class="btn btn--ghost" href="/docs/">{t('site.notFound.readDocs')}</a>
    </div>
  </main>
</Landing>

<style>
  .nf {
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(72px, 14vh, 160px) 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf .eyebrow::before {
    display: none;
  }
  .nf__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin-top: 16px;
    max-width: 16ch;
  }
  .nf__lead {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.1rem;
    max-width: 48ch;
  }
  .nf__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 32px;
  }
</style>

---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/landing/Nav.astro';
---

<Landing
  title="Page not found — Paperless Starfruit"
  description="That page doesn't exist. Head back home or browse the documentation."
>
  <Nav />
  <main class="nf">
    <p class="eyebrow">Error 404</p>
    <h1 class="nf__title">This page got filed somewhere else.</h1>
    <p class="nf__lead">
      The page you&rsquo;re looking for doesn&rsquo;t exist — or never did. Try the
      documentation, or head back to the start.
    </p>
    <div class="nf__btns">
      <a class="btn btn--gold" href="/">Back home</a>
      <a class="btn btn--ghost" href="/docs/">Read the docs</a>
    </div>
  </main>
</Landing>

<style>
  .nf {
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(72px, 14vh, 160px) 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf .eyebrow::before {
    display: none;
  }
  .nf__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin-top: 16px;
    max-width: 16ch;
  }
  .nf__lead {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.1rem;
    max-width: 48ch;
  }
  .nf__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 32px;
  }
</style>

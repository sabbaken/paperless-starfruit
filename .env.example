# API
PORT=3000

# SQLite database file (a directory is created if missing)
DATABASE_PATH=./data/app.db

# 32-byte key (base64 or hex). Encrypts provider/paperless credentials at rest
# AND signs admin session tokens (so rotating it logs everyone out). Keep it
# stable in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. Comma-separated allowed CORS origins. Leave unset to reflect the
# request origin (fine — auth is via bearer token, not cookies).
# CORS_ORIGIN=https://paperless-ai.home.lan

# Optional. Where the "check for updates" feature reads the latest published
# version from (it fetches <url>/version.json). Defaults to the public site;
# override if you publish your own release manifest. The check is opt-in per the
# General settings toggle, and only ever fetches a version number.
# UPDATE_MANIFEST_URL=https://paperless-starfruit.vercel.app

# Optional. Pins the version this instance reports as "current". Defaults to the
# monorepo root package.json version baked in at build time — only set this to
# override (e.g. stamp a git tag in CI).
# APP_VERSION=

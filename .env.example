# API
PORT=3000

# SQLite database file (a directory is created if missing)
DATABASE_PATH=./data/app.db

# 32-byte key (base64 or hex). Encrypts provider/paperless credentials at rest
# AND signs admin session tokens (so rotating it logs everyone out). Keep it
# stable in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. Comma-separated allowed CORS origins. Leave unset to reflect the
# request origin (fine — auth is via bearer token, not cookies).
# CORS_ORIGIN=https://paperless-ai.home.lan

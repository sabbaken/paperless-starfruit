# API
PORT=3000

# SQLite database file (a directory is created if missing)
DATABASE_PATH=./data/app.db

# 32-byte key (base64 or hex). Encrypts provider/paperless credentials at rest
# AND signs admin session tokens (so rotating it logs everyone out). Keep it
# stable in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. Comma-separated allowed CORS origins. Leave unset to reflect the
# request origin (fine — auth is via bearer token, not cookies).
# CORS_ORIGIN=https://paperless-ai.home.lan

# Optional. Where the "check for updates" feature reads the latest release from.
# Must answer with GitHub's releases/latest shape ({ tag_name, html_url }).
# Defaults to this repo's GitHub API endpoint; override if you fork. The check
# is opt-in per the General settings toggle, and only ever fetches release
# metadata.
# UPDATE_CHECK_URL=https://api.github.com/repos/sabbaken/paperless-starfruit/releases/latest

# Optional. Pins the version this instance reports as "current". The published
# Docker image bakes in the release tag at build time; local/dev builds fall
# back to the monorepo root package.json version.
# APP_VERSION=

{
  "name": "paperless-starfruit",
  "version": "1.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @paperless-starfruit/api db:generate",
    "db:migrate": "pnpm --filter @paperless-starfruit/api db:migrate",
    "paperless:up": "docker compose -f docker/docker-compose.paperless.yml up -d",
    "paperless:down": "docker compose -f docker/docker-compose.paperless.yml down",
    "paperless:logs": "docker compose -f docker/docker-compose.paperless.yml logs -f paperless",
    "paperless:token": "sh docker/paperless-token.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@nestjs/core",
      "sharp"
    ],
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml,astro}": "prettier --write"
  }
}
